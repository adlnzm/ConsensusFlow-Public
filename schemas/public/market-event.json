{
  "title": "Illustrative public market observation",
  "description": "Educational projection, not an exported internal event contract. No endpoint or private identifier is required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "asset", "price", "observed_at", "provider", "time_basis"],
  "properties": {
    "contract": {"const": "illustrative-v1"},
    "asset": {"type": "string", "minLength": 1},
    "price": {"type": "number", "exclusiveMinimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "provider": {"type": "string", "minLength": 1},
    "time_basis": {"enum": ["acquisition_observation", "source_event"]}
  }
}
